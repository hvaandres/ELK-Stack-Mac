{
  "cluster": ["monitor"],
  "indices": [
    {
      "names": ["auditbeat-*", "filebeat-*", "metricbeat-*", ".alerts-*"],
      "privileges": ["read", "view_index_metadata"]
    }
  ],
  "applications": [
    {
      "application": "kibana-.kibana",
      "privileges": ["read"],
      "resources": ["*"]
    }
  ],
  "metadata": {
    "description": "Read-only SOC analyst: can search, visualize and investigate but cannot modify data."
  }
}
